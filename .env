# Central place for every port / credential in the sandbox. Compose reads this automatically.

# Horde server
HORDE_HTTP_PORT=13340
HORDE_HTTP2_PORT=13342

# MongoDB
MONGO_USER=horde
MONGO_PASSWORD=dbPass123

# Redis (internal to the compose network, port kept here for reference)
REDIS_PORT=30002

# Perforce: p4d listens on 1666 inside the network; host port chosen to avoid
# clashing with a locally installed P4 server.
P4_PORT=1666
P4_HOST_PORT=11666
P4_SERVICE_USER=horde.build
P4_SERVICE_PASSWORD=HordeBuild123!
