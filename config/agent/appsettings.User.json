{
	// Mounted over the agent's appsettings.User.json inside the container.
	// Binds under the "Horde" config section (see AgentSettings.cs).
	"Horde": {
		// Connect to the sandbox server on the compose network
		"ServerProfiles": {
			"sandbox": {
				"name": "sandbox",
				"url": "http://horde-server:13340"
			}
		},
		"Server": "sandbox",
		"Name": "agent-linux-01",
		"Mode": "Dedicated",

		// Jobs sync/run under a mounted volume
		"WorkingDir": "/agent",
		"LogsDir": "/agent/logs",

		// Sandbox: keep all agent-side data on the mounted volume
		"Installed": false,
		"Ephemeral": false,

		// How many cores/RAM to advertise to the server
		"CpuCount": 2,
		"RamGb": 4
	}
}
